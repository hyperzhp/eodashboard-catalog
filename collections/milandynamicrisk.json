{
  "variables": {
    "temperature": "cold",
    "weekday": "monday",
    "selectedField": "cold_monday"
  },
  "fill-color": [
    "case",
    [">=", ["get", ["var", "selectedField"]], 0],
    [
      "interpolate",
      ["linear"],
      ["get", ["var", "selectedField"]],
      0.0, [49, 54, 149, 0.8],
      0.15, [69, 117, 180, 0.82],
      0.3, [116, 173, 209, 0.84],
      0.45, [224, 243, 219, 0.86],
      0.6, [253, 231, 37, 0.88],
      0.8, [244, 109, 67, 0.92],
      1.0, [165, 15, 21, 0.96]
    ],
    [0, 0, 0, 0]
  ],
  "stroke-color": [255, 255, 255, 0.45],
  "stroke-width": 0.25,
  "tooltip": [
    {"id": "cell_id", "title": "Grid cell"},
    {"id": "{{selectedField}}", "title": "Selected risk index"},
    {"id": "RISK_CLASS", "title": "Risk class"}
  ],
  "legend": {
    "title": "Composite risk index (0–1)",
    "range": [
      "rgba(49,54,149,0.80)",
      "rgba(69,117,180,0.82)",
      "rgba(116,173,209,0.84)",
      "rgba(224,243,219,0.86)",
      "rgba(253,231,37,0.88)",
      "rgba(244,109,67,0.92)",
      "rgba(165,15,21,0.96)"
    ]
  },
  "jsonform": {
    "type": "object",
    "title": "Map configuration",
    "properties": {
      "temperature": {
        "title": "Temperature class",
        "type": "string",
        "enum": ["cold", "hot"],
        "options": {"enum_titles": ["Cold days", "Hot days"]},
        "default": "cold"
      },
      "weekday": {
        "title": "Weekday",
        "type": "string",
        "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
        "options": {
          "enum_titles": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
        },
        "default": "monday"
      },
      "selectedField": {
        "type": "string",
        "template": "{{temperature}}_{{weekday}}",
        "options": {"hidden": true},
        "watch": {"temperature": "temperature", "weekday": "weekday"}
      }
    }
  }
}
